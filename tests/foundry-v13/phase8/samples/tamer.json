        "advancementType": "ItemGrant",
        "grantAtLevel": 3,
        "automation": "phase-5"
      }
    },
    {
      "key": "class.tamer-ryoko.feature.aprimoramento-no-valor-de-habilidade.l4.1",
      "name": "APRIMORAMENTO NO VALOR DE HABILIDADE",
      "level": 4,
      "description": "No 4º, 8º, 12º, 16º e 19º níveis, aumente um atributo em 2 ou dois em 1, sem ultrapassar 20.",
      "page": 199,
      "sourceTitle": "Ryoko's Guide to the Yokai Realms",
