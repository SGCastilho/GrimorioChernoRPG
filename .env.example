# Gere com: npm run admin:hash-password
GRIMORIO_ADMIN_PASSWORD_HASH=scrypt$16384$8$1$SUBSTITUA_O_SALT$SUBSTITUA_O_HASH

# Use ao menos 32 caracteres aleatórios e um valor diferente por ambiente.
GRIMORIO_SESSION_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_DE_32_OU_MAIS_CARACTERES

# mock é o padrão seguro. github só é aceito em VERCEL_ENV=production.
GRIMORIO_ADMIN_WRITE_MODE=mock

# Hosts HTTPS adicionais, separados por vírgula. Imgur já é permitido.
GRIMORIO_ADMIN_IMAGE_HOSTS=

# Necessários somente em Production com WRITE_MODE=github.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main
